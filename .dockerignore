# =============================================================================
# Hybrid Recommendation Intelligence Platform — .dockerignore
# =============================================================================

# Version control
.git/
.gitignore

# Environment files — never bake secrets into images
.env
.env.local
.env.*.local

# Python artifacts
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
.venv/
venv/
env/
*.egg-info/
dist/
build/
.pytest_cache/
.ruff_cache/
.mypy_cache/
htmlcov/
.coverage

# Node.js artifacts
node_modules/
frontend/dist/
frontend/.vite/
npm-debug.log*

# IDE files
.vscode/
.idea/
*.swp
*.swo

# Data and ML artifacts — do not bake datasets into images
data/
ml/**/*.pkl
ml/**/*.pt
ml/**/*.pth
ml/**/*.onnx
mlruns/
mlartifacts/
notebooks/

# Logs
*.log
logs/

# OS files
.DS_Store
Thumbs.db

# Documentation source (not needed in runtime images)
docs/

# Test files are excluded from production images
backend/tests/

# Temporary files
*.tmp
*.temp
